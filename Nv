        end
    end)

    local function isBlocked(name)
        name = name:lower()
        for _, w in ipairs(blockedWords) do
            if name:find(w, 1, true) then return true end
        end
    end

    local function blockGui(g)
        if protectEnabled and isBlocked(g.Name) and g.Name ~= "Nv_HUB" and g.Name ~= "NvSquareBtn" then
            g:Destroy()
        end
    end

