    local function nukeRemote()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent") and obj.Name:lower():find("executeclientcommand") then
                obj:Destroy()
            end
        end
    end

